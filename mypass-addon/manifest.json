{
  "manifest_version": 3,
  "name": "mypass",
  "version": "3.0",
  "author": "Yukkku",

  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [{
    "matches": ["https://*/*", "http://*/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "option.html",
    "open_in_tab": true
  },

  "permissions": [
    "contextMenus",
    "storage"
  ],
  "web_accessible_resources": [{
    "resources": ["*"],
    "matches": ["<all_urls>"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "{0f7e3393-e120-4b1f-9d5c-46ffdfde4195}"
    }
  }
}
