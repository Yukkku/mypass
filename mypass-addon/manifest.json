{
  "manifest_version": 2,
  "name": "mypass",
  "version": "3.0",
  "author": "Yukkku",

  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [{
    "matches": ["https://*/*", "http://*/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "browser_action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "option.html"
  },

  "permissions": [
    "contextMenus",
    "storage"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",

  "browser_specific_settings": {
    "gecko": {
      "id": "{0f7e3393-e120-4b1f-9d5c-46ffdfde4195}"
    }
  }
}
